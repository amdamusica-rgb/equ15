<!DOCTYPE html><html lang="id"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>TaGunner EQ BUNYI</title><style>body{margin:0;background:#05070a;color:#fff;font-family:system-ui;padding:10px;text-align:center}h1{font-weight:900}.console{background:#121a26;border:2px solid #334;border-radius:14px;padding:10px;max-width:800px;margin:auto}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px} .card{background:#1a2535;border-radius:10px;padding:8px;border:1px solid #2a3a4a} .card label{font-size:8px;font-weight:800;display:block;height:28px} input{width:100%} .val{background:#000;border-radius:4px;padding:2px;font-size:10px;margin-top:3px} .btn{width:100%;max-width:400px;padding:14px;border-radius:25px;border:none;font-weight:900;font-size:16px;margin-top:12px;background:linear-gradient(#00e5ff,#0097a7);color:#fff}</style></head><body><h1>TaGunner EQ<br>เทสๆ 8D</h1><p style="color:#00e5ff;font-weight:700">แนะนำให้ใส่หูฟัง 🎧 BISA BUNYI BOS</p><div class="console"><div class="grid"><div class="card"><label>GRAPHIC EQ<br>VOL</label><input type="range" id="vol" min="0" max="150" value="120"><div class="val" id="v_vol">120%</div></div><div class="card"><label>PARAMETRIC<br>WIDE</label><input type="range" id="wide" min="0" max="150" value="105"><div class="val" id="v_wide">105%</div></div><div class="card"><label>LOW</label><input type="range" id="low" min="-12" max="12" value="0"><div class="val" id="v_low">0 dB</div></div><div class="card"><label>MID</label><input type="range" id="mid" min="-12" max="12" value="0.5"><div class="val" id="v_mid">+0.5 dB</div></div><div class="card"><label>HIGH</label><input type="range" id="high" min="-12" max="12" value="-0.5"><div class="val" id="v_high">-0.5 dB</div></div><div class="card"><label>BASS BOOST</label><input type="range" id="bass" min="0" max="15" value="6"><div class="val" id="v_bass">+6 dB</div></div></div><button class="btn" id="playBtn">▶ PLAY BASS 8D BOS</button></div><script>let ctx,gN,lF,mF,hF,bF,p,o,lfo;function i(){if(ctx)return;ctx=new AudioContext();gN=ctx.createGain();lF=ctx.createBiquadFilter();lF.type='lowshelf';lF.frequency.value=320;mF=ctx.createBiquadFilter();mF.type='peaking';mF.frequency.value=1000;hF=ctx.createBiquadFilter();hF.type='highshelf';hF.frequency.value=3200;bF=ctx.createBiquadFilter();bF.type='lowshelf';bF.frequency.value=120;p=ctx.createStereoPanner();lF.connect(mF);mF.connect(hF);hF.connect(bF);bF.connect(p);p.connect(gN);gN.connect(ctx.destination);}playBtn.onclick=async()=>{i();await ctx.resume();if(o){o.forEach(a=>{try{a.stop()}catch{}})}let o1=ctx.createOscillator(),o2=ctx.createOscillator(),og=ctx.createGain();o1.frequency.value=60;o2.frequency.value=120;og.gain.value=.8;o1.connect(og);o2.connect(og);og.connect(lF);o1.start();o2.start();o=[o1,o2,og];lF.gain.value=low.value;mF.gain.value=mid.value;hF.gain.value=high.value;bF.gain.value=bass.value;gN.gain.value=vol.value/100;clearInterval(lfo);lfo=setInterval(()=>{p.pan.value=Math.sin(Date.now()/800)*(wide.value/100)},30);playBtn.textContent='🔊 BUNYI BOS!'};vol.oninput=e=>{if(gN)gN.gain.value=e.target.value/100;v_vol.textContent=e.target.value+'%'};low.oninput=e=>{if(lF)lF.gain.value=e.target.value;v_low.textContent=e.target.value+' dB'};mid.oninput=e=>{if(mF)mF.gain.value=e.target.value;v_mid.textContent=e.target.value+' dB'};high.oninput=e=>{if(hF)hF.gain.value=e.target.value;v_high.textContent=e.target.value+' dB'};bass.oninput=e=>{if(bF)bF.gain.value=e.target.value;v_bass.textContent='+'+e.target.value+' dB'};wide.oninput=e=>{v_wide.textContent=e.target.value+'%'};</script></body></html>
